// Kleit — the private test site on workers.dev (roadmap M1.2, spec 2.1 #4 and #11, decision 109).
// The app itself is a static SPA bundle (TanStack Start SPA mode). Cloudflare serves those files
// for free; unknown paths fall back to the app shell so deep links like /@name still load.
// /s/* is reserved for the share-page Worker (worker/index.ts) and NEVER falls back to the shell —
// that is what keeps link previews and Google indexing possible later (technical pack §7 #10).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kleit-test",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    // SPA mode prerenders the shell as _shell.html; Cloudflare's SPA fallback serves /index.html.
    "command": "npm run build && cp .output/public/_shell.html .output/public/index.html"
  },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every path the Worker answers must be here, or the assets' SPA fallback serves the app shell
    // in its place (2026-10-19: /impersonation and /trademark were routed in the Worker and not
    // listed here, and the live site showed the shell where the two claim forms should have been).
    "run_worker_first": ["/s/*", "/p/*", "/e/*", "/takedown", "/takedown/*", "/copyright", "/impersonation", "/trademark", "/contact", "/delete-account", "/sitemap.xml"]
  },
  // The share Worker's one question goes to the database with the PUBLIC key (the same one the
  // app ships with); the function it calls answers only what a guest may see.
  "vars": {
    "SUPABASE_URL": "https://zoimaafxtweeoqnmrbkh.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpvaW1hYWZ4dHdlZW9xbm1yYmtoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk3NTk0NTksImV4cCI6MjEwNTMzNTQ1OX0.Y36kR7rHVNdSACsZFK39lxdyjgR3PUWZyP0ae0UGjZw"
  },
  "observability": { "enabled": true }
}
